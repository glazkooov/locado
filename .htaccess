# Настройки сервера для Beget (Apache). Файл скрытый — при загрузке по FTP
# включи показ скрытых файлов, иначе он не попадёт на хостинг.

Options -Indexes
DirectoryIndex index.html
AddDefaultCharset utf-8

# Один адрес сайта: https и без www — иначе поисковики и Метрика считают
# http://, https:// и www. разными сайтами
<IfModule mod_rewrite.c>
  RewriteEngine On
  # На Beget Apache стоит за nginx: https виден по заголовку X-Forwarded-Proto.
  # Проверяем оба признака, иначе перенаправление может зациклиться.
  # Если сайт всё же уходит в бесконечную переадресацию — закомментируй эти
  # три строки и включи «Перенаправлять на HTTPS» в панели Beget
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://locado.ru%{REQUEST_URI} [R=301,L]

  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://locado.ru%{REQUEST_URI} [R=301,L]

  # Служебные файлы и папки проекта не отдаём, если их всё-таки загрузили
  RewriteRule (^|/)\.(?!well-known) - [F]
  RewriteRule ^(docs|tools)(/|$) - [F]
</IfModule>

# Своя страница «Такой страницы нет» вместо стандартной ошибки сервера
ErrorDocument 404 /404.html

# Сайт отдаётся сжатым — быстрее на мобильном интернете
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json application/manifest+json image/svg+xml
</IfModule>

# Типы файлов, которых может не быть в настройках сервера
AddType application/manifest+json .webmanifest
AddType font/woff2 .woff2

# Кэш в браузере. Фото и шрифты меняются редко — месяц.
# Страницы, стили, скрипты и данные браузер перепроверяет при каждом заходе
# (no-cache: если файл не менялся, сервер отвечает коротким 304). Иначе после
# обновления сайта браузер мог взять новую страницу со старыми стилями из
# кэша — и вёрстка ломалась.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/css "access plus 0 seconds"
  ExpiresByType application/javascript "access plus 0 seconds"
  ExpiresByType application/json "access plus 0 seconds"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(html|css|js|mjs|json|webmanifest)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
