# Настройки сервера для Beget (Apache). Файл скрытый — при загрузке по FTP
# включи показ скрытых файлов, иначе он не попадёт на хостинг.

Options -Indexes
# index.php — у страниц места и подборки (place/, collection/): сервер
# вписывает в HTML название, описание и фото для превью ссылок в
# мессенджерах (api/og.php). В остальных папках только index.html
DirectoryIndex index.php index.html
AddDefaultCharset utf-8

# Один адрес сайта: https и без www — иначе поисковики и Метрика считают
# http://, https:// и www. разными сайтами
<IfModule mod_rewrite.c>
  RewriteEngine On
  # На Beget Apache стоит за nginx: https виден по заголовку X-Forwarded-Proto.
  # Проверяем оба признака, иначе перенаправление может зациклиться.
  # Если сайт всё же уходит в бесконечную переадресацию — закомментируй эти
  # три строки и включи «Перенаправлять на HTTPS» в панели Beget
  # Адрес берём из запроса, а не пишем locado.ru: тот же файл работает и на
  # тестовом поддомене (test.locado.ru), не уводя его на основной сайт
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

  # Служебные файлы и папки проекта не отдаём, если их всё-таки загрузили
  RewriteRule (^|/)\.(?!well-known) - [F]
  RewriteRule ^(docs|tools)(/|$) - [F]
  RewriteRule ^(CLAUDE\.md|package\.json)$ - [F]
  # Журнал Telegram-канала: там черновики постов (tools/telegram.mjs)
  RewriteRule ^data/telegram-log\.json$ - [F]

  # Красивые адреса: /place/kolomenskoe и /collection/vdol-reki. Старые
  # ?slug=… (ссылки в чатах, закладки) — постоянная переадресация на новые.
  # THE_REQUEST — исходный запрос браузера: внутренняя подмена ниже его не
  # меняет, поэтому переадресация не зацикливается. Адрес — сразу с https:
  # Apache за nginx считает запрос http-шным, и короткий /%1/%2 уводил на
  # http://, откуда был ещё один прыжок
  RewriteCond %{THE_REQUEST} \s/(place|collection)/(?:index\.(?:html|php))?\?(?:[^\s]*&)?slug=([a-z0-9-]+)[&\s] [NC]
  RewriteRule ^ https://%{HTTP_HOST}/%1/%2? [R=301,L]
  # Сама страница — одна на все места: slug из адреса уходит в index.php
  RewriteRule ^(place|collection)/([a-z0-9-]+)/?$ $1/index.php?slug=$2 [L,QSA]
</IfModule>

# Тестовый поддомен и любые другие адреса, кроме основного, поисковики
# не индексируют
<IfModule mod_headers.c>
  <If "%{HTTP_HOST} != 'locado.ru'">
    Header set X-Robots-Tag "noindex, nofollow"
  </If>
</IfModule>

# Заголовки безопасности. Ставит их Apache — то есть на страницы, PHP и
# данные; картинки, стили и скрипты отдаёт nginx Бегета, им они не нужны.
# always — и на переадресации, и на страницы ошибок
<IfModule mod_headers.c>
  # Только https: браузер, раз зайдя, больше не пробует http (год)
  Header always set Strict-Transport-Security "max-age=31536000"
  # Не угадывать тип файла: скрипт — только то, что отдано как скрипт
  Header always set X-Content-Type-Options "nosniff"
  # Чужим сайтам — только адрес Локадо, без страницы и поиска
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # frame-ancestors — сайт нельзя встроить в чужую страницу (кроме Метрики:
  # карта кликов показывает сайт во фрейме); base-uri — нельзя подменить
  # <base>; object-src — никаких плагинов; form-action — формы уходят только
  # к нам и в Яндекс Формы. Список разрешённых скриптов не задаём: Карты и
  # Метрика грузят ресурсы с десятков адресов Яндекса и меняют их без
  # предупреждения, а строгий список сломал бы карту
  Header always set Content-Security-Policy "frame-ancestors 'self' https://metrika.yandex.ru https://metrica.yandex.com https://webvisor.com https://*.webvisor.com; base-uri 'self'; object-src 'none'; form-action 'self' https://forms.yandex.ru"
  # Версию PHP наружу не показываем
  Header always unset X-Powered-By
  Header unset X-Powered-By
</IfModule>

# Своя страница «Такой страницы нет» вместо стандартной ошибки сервера
ErrorDocument 404 /404.html

# Сайт отдаётся сжатым — быстрее на мобильном интернете
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json application/manifest+json image/svg+xml
</IfModule>

# Типы файлов, которых может не быть в настройках сервера
AddType application/manifest+json .webmanifest
AddType font/woff2 .woff2

# Кэш в браузере. Фото и шрифты меняются редко — месяц.
# Страницы, стили, скрипты и данные браузер перепроверяет при каждом заходе
# (no-cache: если файл не менялся, сервер отвечает коротким 304). Иначе после
# обновления сайта браузер мог взять новую страницу со старыми стилями из
# кэша — и вёрстка ломалась.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/css "access plus 0 seconds"
  ExpiresByType application/javascript "access plus 0 seconds"
  ExpiresByType application/json "access plus 0 seconds"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(html|css|js|mjs|json|webmanifest)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
